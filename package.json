{
  "name": "@pranavraut033/ats-checker",
  "version": "1.4.0",
  "description": "Deterministic, configurable ATS (Applicant Tracking System) compatibility checker with no external dependencies. Analyze resumes, generate scores, and get actionable suggestions.",
  "license": "MIT",
  "author": {
    "name": "Pranav Raut",
    "url": "https://github.com/Pranavraut033"
  },
  "contributors": [
    {
      "name": "Pranav Raut",
      "url": "https://github.com/Pranavraut033"
    }
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Pranavraut033"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Pranavraut033/ats-checker"
  },
  "bugs": {
    "url": "https://github.com/Pranavraut033/ats-checker/issues"
  },
  "homepage": "https://github.com/Pranavraut033/ats-checker#readme",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./pdf": {
      "types": "./dist/pdf/index.d.ts",
      "import": "./dist/pdf/index.mjs",
      "require": "./dist/pdf/index.cjs",
      "default": "./dist/pdf/index.mjs"
    },
    "./en": {
      "types": "./dist/lang/en/index.d.ts",
      "import": "./dist/lang/en/index.mjs",
      "require": "./dist/lang/en/index.cjs",
      "default": "./dist/lang/en/index.mjs"
    },
    "./de": {
      "types": "./dist/lang/de/index.d.ts",
      "import": "./dist/lang/de/index.mjs",
      "require": "./dist/lang/de/index.cjs",
      "default": "./dist/lang/de/index.mjs"
    }
  },
  "peerDependencies": {
    "pdfjs-dist": ">=4"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ats",
    "resume",
    "job-description",
    "scoring",
    "compatibility",
    "hiring",
    "checker",
    "analysis",
    "applicant-tracking"
  ],
  "scripts": {
    "build": "tsup && npm run build:ui",
    "build:ui": "rm -rf ui/public/dist && cp -r dist ui/public/dist",
    "serve": "npx http-server ui/public -p ${PORT:-3005}",
    "dev": "npm run serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^25.0.3",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "express": "^4.18.2",
    "pdfjs-dist": "^4.10.38",
    "prettier": "^3.7.4",
    "tsup": "^8.3.0",
    "tsx": "^4.7.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.0.16"
  }
}
